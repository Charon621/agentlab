# 优先在网页「模型配置」填写。兼容旧.env时需网页显式认领；默认 mock 无需密钥。
AGENTLAB_HOST=127.0.0.1
AGENTLAB_PORT=8811
# 可选独立数据目录，默认项目下 data/
# AGENTLAB_DATA_DIR=E:/AgentData/agentlab
AGENTLAB_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-plus
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-5
# 单位：美元/百万 tokens；不填则费用显示未知。按你的账号价格填写。
QWEN_INPUT_PRICE_PER_MILLION=
QWEN_OUTPUT_PRICE_PER_MILLION=
KIMI_INPUT_PRICE_PER_MILLION=
KIMI_OUTPUT_PRICE_PER_MILLION=
# wikipedia 无需密钥；tavily 适合较广的网页研究。
AGENTLAB_SEARCH=wikipedia
# json: 结构化queries调度；native: 原生OpenAI tools/tool_calls，实际执行search_web并回传tool消息。
AGENTLAB_TOOL_MODE=json
TAVILY_API_KEY=
